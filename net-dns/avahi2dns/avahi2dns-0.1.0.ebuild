# Generated by Perplexity computer

EAPI=8

inherit go-module systemd

DESCRIPTION="Small DNS server which interfaces with avahi (through D-Bus), perfect for musl/Alpine-like setups"
HOMEPAGE="https://github.com/LouisBrunner/avahi2dns"
SRC_URI="
	https://github.com/LouisBrunner/${PN}/archive/v${PV}.tar.gz -> ${P}.tar.gz
	https://github.com/LouisBrunner/${PN}/releases/download/${PV}/${P}-vendor.tar.xz
"

LICENSE="MIT Apache-2.0 BSD MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm ~arm64 ~x86"
IUSE="systemd"

RDEPEND="
	net-dns/avahi
	sys-apps/dbus
"
BDEPEND=">=dev-lang/go-1.24"

# The vendor tarball must be created from upstream sources:
#
#   git clone https://github.com/LouisBrunner/avahi2dns
#   cd avahi2dns
#   git checkout v0.1.0
#   GOMODCACHE="${PWD}"/go-mod go mod download -modcacherw
#   XZ_OPT='-T0 -9' tar -acf avahi2dns-0.1.0-vendor.tar.xz go-mod
#
# Alternatively, using vendor mode (simpler):
#
#   go mod vendor
#   XZ_OPT='-T0 -9' tar -acf avahi2dns-0.1.0-vendor.tar.xz \
#       --xform 's:^:avahi2dns-0.1.0/:' vendor
#
# Then host the tarball in your distfiles or overlay's files/.

src_compile() {
	ego build -o avahi2dns .
}

src_install() {
	dobin avahi2dns

	# systemd unit
	use systemd && systemd_dounit "${S}"/systemd/avahi2dns.service

	# OpenRC init script
	doinitd "${FILESDIR}"/avahi2dns.initd

	dodoc README.md
}

pkg_postinst() {
	if ! use systemd; then
		elog "An OpenRC init script has been installed."
		elog "To start avahi2dns at boot:"
		elog "  rc-update add avahi2dns default"
		elog "  rc-service avahi2dns start"
	fi
	elog ""
	elog "avahi2dns listens on port 5354 by default. Configure your"
	elog "resolver (e.g. /etc/resolv.conf or nsswitch.conf) to use it."
}

