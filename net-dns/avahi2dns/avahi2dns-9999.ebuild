EAPI=8

inherit go-module git-r3 systemd

DESCRIPTION="Small DNS server which interfaces with avahi (through D-Bus), perfect for musl/Alpine-like setups"
HOMEPAGE="https://github.com/LouisBrunner/avahi2dns"
EGIT_REPO_URI="https://github.com/LouisBrunner/avahi2dns.git"

LICENSE="MIT Apache-2.0 BSD"
SLOT="0"
KEYWORDS=""
IUSE="systemd"

RDEPEND="
	net-dns/avahi
	sys-apps/dbus
"
BDEPEND=">=dev-lang/go-1.24"

src_unpack() {
	git-r3_src_unpack
	go-module_live_vendor
}

src_compile() {
	ego build -o avahi2dns .
}

src_install() {
	dobin avahi2dns

	# systemd unit
	use systemd && systemd_dounit "${S}"/systemd/avahi2dns.service

	# OpenRC init script
	doinitd "${FILESDIR}"/avahi2dns.initd

	dodoc README.md
}

pkg_postinst() {
	if ! use systemd; then
		elog "An OpenRC init script has been installed."
		elog "To start avahi2dns at boot:"
		elog "  rc-update add avahi2dns default"
		elog "  rc-service avahi2dns start"
	fi
	elog ""
	elog "avahi2dns listens on port 5354 by default. Configure your"
	elog "resolver (e.g. /etc/resolv.conf or nsswitch.conf) to use it."
}
